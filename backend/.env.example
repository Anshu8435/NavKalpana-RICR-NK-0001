# Application Environment
NODE_ENV=development

# Server Configuration
PORT=5000

# Database Configuration
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# Legacy alias: MONGODB_URI also works

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:5173

# CORS - Comma-separated allowed origins (optional, defaults to FRONTEND_URL)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# ML Service Configuration (set to your Render ML service URL in production)
ML_SERVICE_URL=http://localhost:8000

# Email Configuration (Gmail Example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
# Legacy alias: EMAIL_PASS also works
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=CardioShield AI
